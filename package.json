{
  "name": "with-work",
  "displayName": "一点微小的工作",
  "version": "100.0.0",
  "private": true,
  "description": "很惭愧，只是做了一点微小的工作",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --mode single && node scripts/ship-single.mjs",
    "build:single": "vue-tsc --noEmit && vite build --mode single",
    "icons": "node scripts/icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@lucide/vue": "^1.33.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.52.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.3.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
